    "index.mjs",
    "index.d.ts",
    "bin/"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "keywords": [
    "ring",
    "ring camera",
    "doorbell",
    "webrtc",
    "home automation",
    "zero dependencies"
  ],
  "author": "404Dealer",
  "license": "MIT"
}
