{
  "name": "ring-lite",
  "version": "0.1.1",
  "description": "A small, dependency-free client for Ring cameras: snapshots, events, clips, controls and WebRTC live view in your own browser. Unofficial.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    }
  },
  "types": "./index.d.ts",
  "bin": {
    "ring-lite-signin": "bin/ring-lite-signin.mjs"
  },
